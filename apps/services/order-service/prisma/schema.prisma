datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model SyntheseOT {
  id               Int             @id @default(autoincrement())
  reference        String          @unique @db.VarChar(40)
  periodeDebut     DateTime        @map("periode_debut") @db.Date
  periodeFin       DateTime        @map("periode_fin") @db.Date
  typeFluxId       Int             @map("type_flux_id")
  statut           String          @db.VarChar(25)
  auteurId         Int             @map("auteur_id")
  transmisParId    Int?            @map("transmis_par_id")
  montantTotal     BigInt          @default(0) @map("montant_total") @db.BigInt
  nbTransactions   Int             @default(0) @map("nb_transactions")
  dateGeneration   DateTime        @default(now()) @map("date_generation") @db.Timestamptz
  dateTransmission DateTime?       @map("date_transmission") @db.Timestamptz
  ordresTraitement   OrdreTraitement[]

  @@index([typeFluxId])
  @@index([statut])
  @@map("synthese_ot")
}

model OrdreTraitement {
  id                                    Int        @id @default(autoincrement())
  codeOt                                String     @unique @map("code_ot") @db.VarChar(30)
  syntheseId                            Int        @map("synthese_id")
  synthese                              SyntheseOT @relation(fields: [syntheseId], references: [id], onDelete: Cascade)
  antenneId                             Int        @map("antenne_id")
  niveauId                              Int        @map("niveau_id")
  typeRecetteId                         Int        @map("type_recette_id")
  statutId                              Int?       @map("statut_id")
  montantCumule                         BigInt     @default(0) @map("montant_cumule") @db.BigInt
  nombreFlux                            Int        @default(0) @map("nombre_flux")
  statut                                String     @default("Brouillon") @db.VarChar(30)
  creeParId                             Int        @map("cree_par_id")
  valideParId                           Int?       @map("valide_par_id")
  dateCreation                          DateTime   @default(now()) @map("date_creation") @db.Timestamptz
  dateEmission                          DateTime?  @map("date_emission") @db.Timestamptz
  dateTransmissionBudget                DateTime?  @map("date_transmission_budget") @db.Timestamptz
  dateValidationChefComptable           DateTime?  @map("date_validation_chef_comptable") @db.Timestamptz
  validateurChefComptableId             Int?       @map("validateur_chef_comptable_id")
  dateApprobationDirecteurFinancier     DateTime?  @map("date_approbation_directeur_financier") @db.Timestamptz
  approbateurDirecteurFinancierId       Int?       @map("approbateur_directeur_financier_id")
  motifRejet                            String?    @map("motif_rejet") @db.Text
  dateRejet                             DateTime?  @map("date_rejet") @db.Timestamptz
  datePaiement                          DateTime?  @map("date_paiement") @db.Timestamptz
  pdfPath                               String?    @map("pdf_path") @db.VarChar(255)
  pdfUrl                                String?    @map("pdf_url") @db.VarChar(500)
  version                               Int        @default(1)
  titre                                 String?    @db.VarChar(180)
  description                           String?    @db.Text
  referenceVague                        String?    @map("reference_vague") @db.VarChar(80)
  transmisParId                         Int?       @map("transmis_par_id")
  dateTransmissionSynthese              DateTime?  @map("date_transmission_synthese") @db.Timestamptz
  transmissionHistory                   OtTransmissionHistory[]

  @@index([syntheseId])
  @@index([codeOt])
  @@index([antenneId])
  @@index([niveauId])
  @@index([typeRecetteId])
  @@index([statut])
  @@map("ordre_traitement")
}

model OtCounter {
  year      Int
  antenneId Int        @map("antenne_id")
  sequence  Int        @default(0)

  @@id([year, antenneId])
  @@map("ot_counter")
}

model OutboxMessage {
  id            Int       @id @default(autoincrement())
  type          String    @db.VarChar(80)
  payload       Json
  status        String    @default("PENDING") @db.VarChar(20)
  retryCount    Int       @default(0) @map("retry_count")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastAttemptAt DateTime? @map("last_attempt_at") @db.Timestamptz

  @@index([status, createdAt])
  @@map("outbox_message")
}

model OtTransmissionHistory {
  id                 Int              @id @default(autoincrement())
  ordreTraitementId  Int              @map("ordre_traitement_id")
  ordreTraitement    OrdreTraitement  @relation(fields: [ordreTraitementId], references: [id], onDelete: Cascade)
  referenceVague     String           @map("reference_vague") @db.VarChar(80)
  titre              String           @db.VarChar(180)
  description        String?          @db.Text
  utilisateurId      Int              @map("utilisateur_id")
  nombreLignes       Int              @default(0) @map("nombre_lignes")
  nombreFlux         Int              @default(0) @map("nombre_flux")
  montantTotal       BigInt           @default(0) @map("montant_total") @db.BigInt
  dateTransmission   DateTime         @default(now()) @map("date_transmission") @db.Timestamptz

  @@index([referenceVague])
  @@index([ordreTraitementId])
  @@map("ot_transmission_history")
}
