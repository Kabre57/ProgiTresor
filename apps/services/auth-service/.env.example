# Configuration du serveur
PORT=5001
NODE_ENV=development

# Base de données
DATABASE_URL="postgresql://user:password@localhost:5432/progi_auth?schema=public"

# Sécurité JWT
JWT_SECRET=votre_secret_jwt_tres_long_et_aleatoire
REFRESH_TOKEN_SECRET=votre_secret_refresh_token_tres_long_et_aleatoire

# Logs
LOG_LEVEL=debug
