datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Antenne {
  id        Int        @id @default(autoincrement())
  code      String     @unique @db.VarChar(10)
  nom       String     @unique @db.VarChar(80)
  ville     String     @db.VarChar(60)
  actif     Boolean    @default(true)
  etudiant Etudiant[]

  @@map("antenne")
}

model Filiere {
  id          Int        @id @default(autoincrement())
  code        String     @unique @db.VarChar(10)
  libelle     String     @db.VarChar(60)
  abreviation String     @db.VarChar(30)
  etudiants   Etudiant[]

  @@map("filiere")
}

model StatutEtudiant {
  id            Int                   @id @default(autoincrement())
  code          String                @unique @db.VarChar(20)
  libelle       String                @db.VarChar(60)
  etudiant      Etudiant[]

  @@map("statut_etudiant")
}

model Promotion {
  id        Int        @id @default(autoincrement())
  niveau    String     @default("") @db.VarChar(50)
  nom       String     @db.VarChar(50)
  ordre     Int        @db.SmallInt
  actif     Boolean    @default(true)
  etudiant  Etudiant[]

  @@unique([nom, niveau])
  @@map("promotion")
}

model Etudiant {
  id                 Int            @id @default(autoincrement())
  matricule          String         @unique @db.VarChar(30)
  nom                String         @db.VarChar(75)
  prenom             String         @db.VarChar(75)
  prefixeMatricule   String?        @map("prefixe_matricule") @db.VarChar(10)
  promotionString    String?        @map("promotion") @db.VarChar(50)
  promotionId        Int?           @map("promotion_id")
  promotion          Promotion?     @relation(fields: [promotionId], references: [id])
  antenneId          Int            @map("antenne_id")
  antenne            Antenne        @relation(fields: [antenneId], references: [id])
  filiereId          Int            @map("filiere_id")
  filiere            Filiere        @relation(fields: [filiereId], references: [id])
  statutId           Int            @map("statut_id")
  statut             StatutEtudiant @relation(fields: [statutId], references: [id])
  photoUrl           String?        @map("photo_url") @db.Text
  dateCreation       DateTime       @default(now()) @map("date_creation") @db.Timestamptz
  matriculeTresorPay String?        @unique @map("matricule_tresor_pay") @db.VarChar(50)
  estTemporaire      Boolean        @default(false) @map("est_temporaire")
  notificationsTemporaires NotificationEtudiantTemporaire[]
  nomenclatures            NomenclatureProduit[]

  @@index([antenneId])
  @@index([filiereId])
  @@index([statutId])
  @@index([nom])
  @@index([prenom])
  @@index([promotionString])
  @@index([promotionId])
  @@map("etudiant")
}

model NotificationEtudiantTemporaire {
  id                  Int      @id @default(autoincrement())
  dateCreation        DateTime @default(now()) @map("date_creation") @db.Timestamptz
  matriculeTresorPay  String   @map("matricule_tresor_pay") @db.VarChar(50)
  nomPayeur           String   @map("nom_payeur") @db.VarChar(200)
  etudiantTemporaireId Int      @map("etudiant_temporaire_id")
  etudiantTemporaire  Etudiant @relation(fields: [etudiantTemporaireId], references: [id], onDelete: Cascade)
  traite              Boolean  @default(false)

  @@index([etudiantTemporaireId])
  @@map("notification_etudiant_temporaire")
}

model TypeFlux {
  id      Int           @id @default(autoincrement())
  code    String        @unique @db.VarChar(20)
  libelle String        @db.VarChar(60)
  recettes TypeRecette[]

  @@map("type_flux")
}

model TypeRecette {
  id             Int                   @id @default(autoincrement())
  code           String                @unique @db.VarChar(100)
  libelle        String                @db.VarChar(120)
  typeFluxId     Int                   @map("type_flux_id")
  typeFlux       TypeFlux              @relation(fields: [typeFluxId], references: [id])
  nomenclatures  NomenclatureProduit[]

  @@index([typeFluxId])
  @@map("type_recette")
}

model NomenclatureProduit {
  id              Int             @id @default(autoincrement())
  codeProduit     String          @unique @map("code_produit") @db.VarChar(100)
  libelle         String          @map("libelle") @db.VarChar(150)
  typeRecetteId   Int             @map("type_recette_id")
  typeRecette     TypeRecette     @relation(fields: [typeRecetteId], references: [id])
  montant         Int             @default(0)
  actif           Boolean         @default(true)
  regexPattern    String?         @map("regex_pattern") @db.VarChar(500)
  etudiants       Etudiant[]

  @@index([typeRecetteId])
  @@index([actif])
  @@map("nomenclature_produit")
}
