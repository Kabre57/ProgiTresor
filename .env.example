# Ne jamais utiliser ces valeurs telles quelles en production.
# Générer les secrets avec: openssl rand -hex 32
JWT_SECRET=changez_ce_secret_jwt_par_une_valeur_aleatoire_de_64_caracteres
REFRESH_TOKEN_SECRET=changez_ce_secret_refresh_par_une_valeur_aleatoire_de_64_caracteres
INTERNAL_API_SECRET=changez_ce_secret_interne_par_une_valeur_aleatoire_de_64_caracteres
REDIS_URL=redis://redis:6379
CORS_ORIGIN=http://localhost:3030
POSTGRES_USER=postgres
# Utiliser des caractères hexadécimaux ou encoder le mot de passe dans DATABASE_URL.
POSTGRES_PASSWORD=changez_ce_mot_de_passe_par_une_valeur_hexadecimale
DATABASE_URL_AUTH=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/progi_auth
DATABASE_URL_ETUDIANT=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/progi_etudiant
DATABASE_URL_TRANSACTION=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/progi_transaction
DATABASE_URL_ORDER=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/progi_order
DATABASE_URL_ANALYSE=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/progi_analyse
DATABASE_URL_COMPTA=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/progi_compta
DATABASE_URL_BUDGET=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/progi_budget
MINIO_ROOT_USER=changez_ce_compte_minio
MINIO_ROOT_PASSWORD=changez_ce_mot_de_passe_minio
PDF_STORAGE_TYPE=s3
PDF_PUBLIC_BASE_URL=http://localhost:4000/api/analyse
# Ne définir RUN_SEED=true que pour un bootstrap explicite et unique.
RUN_SEED=false
# Le seed auth crée uniquement le super administrateur et réinitialise ses accès.
