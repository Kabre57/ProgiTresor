# IMPORTANT: JWT_SECRET et REFRESH_TOKEN_SECRET doivent impérativement faire au moins 32 caractères de long.
# Vous pouvez les générer avec la commande: openssl rand -base64 32
JWT_SECRET=votre_secret_jwt_tres_long_de_plus_de_32_caracteres!
REFRESH_TOKEN_SECRET=votre_secret_refresh_tres_long_de_plus_de_32_caracteres!
REDIS_URL=redis://redis:6379
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL_AUTH=postgresql://postgres:postgres@postgres:5432/progi_auth
DATABASE_URL_STUDENT=postgresql://postgres:postgres@postgres:5432/progi_student
DATABASE_URL_TRANSACTION=postgresql://postgres:postgres@postgres:5432/progi_transaction
DATABASE_URL_ORDER=postgresql://postgres:postgres@postgres:5432/progi_order

