    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /login - admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('response contains tokens and user', function () {",
                  "  pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.refreshToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.user).to.be.an('object');",
                  "  pm.expect(json.user.username).to.eql(pm.environment.get('username'));",
                  "  pm.expect(json.user.role.code).to.eql('ADMIN');",
                  "});",
                  "",
                  "pm.environment.set('accessToken', json.token);",
                  "pm.environment.set('refreshToken', json.refreshToken);",
                  "pm.environment.set('currentUserId', String(json.user.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            }
          },
          "response": []
        },
