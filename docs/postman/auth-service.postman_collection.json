              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('updated user is inactive', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.id).to.eql(Number(pm.environment.get('testUserId')));",
                  "  pm.expect(json.actif).to.eql(false);",
                  "  pm.expect(json.service).to.eql('Postman QA');",
                  "});"
                ]
              }
            }
