        {
          "name": "POST /users - create test user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now();",
                  "pm.environment.set('testUsername', `postman.${suffix}`);",
                  "pm.environment.set('testEmail', `postman.${suffix}@progitresor.local`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('created user has expected role', function () {",
                  "  pm.expect(json.id).to.be.a('number');",
                  "  pm.expect(json.username).to.eql(pm.environment.get('testUsername'));",
                  "  pm.expect(json.role.code).to.eql('CONSULTANT');",
                  "});",
                  "",
                  "pm.environment.set('testUserId', String(json.id));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Postman\",\n  \"prenom\": \"Tester\",\n  \"username\": \"{{testUsername}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"Password123!\",\n  \"roleCode\": \"CONSULTANT\",\n  \"service\": \"QA\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            }
          },
          "response": []
        },
        {
          "name": "PUT /users/:id - update test user",
          "event": [
