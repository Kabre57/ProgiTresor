                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const roles = pm.response.json();",
                  "",
                  "pm.test('returns seeded ADMIN role', function () {",
                  "  pm.expect(roles).to.be.an('array').that.is.not.empty;",
                  "  const admin = roles.find((role) => role.code === 'ADMIN');",
                  "  pm.expect(admin).to.be.an('object');",
