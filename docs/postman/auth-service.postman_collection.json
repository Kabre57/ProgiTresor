              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('service is healthy', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.include({ status: 'ok', service: 'auth-service' });",
                  "});"
                ]
              }
            }
