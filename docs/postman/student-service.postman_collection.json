      "name": "System",
      "item": [
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('service is healthy', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.eql('ok');",
                  "  pm.expect(json.service).to.eql('student-service');",
                  "  pm.expect(json.redis).to.eql('PONG');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{studentBaseUrl}}/health",
              "host": ["{{studentBaseUrl}}"],
              "path": ["health"]
            }
          },
          "response": []
        }
      ]
    },
