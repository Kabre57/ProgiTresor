        {
          "name": "GET /antennes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const antennes = pm.response.json();",
                  "pm.test('returns 8 seeded antennes', function () {",
                  "  pm.expect(antennes).to.be.an('array');",
                  "  pm.expect(antennes.length).to.be.at.least(8);",
                  "  pm.expect(antennes.map((a) => a.code)).to.include('ABJ');",
                  "});",
                  "const abj = antennes.find((antenne) => antenne.code === 'ABJ') || antennes[0];",
                  "pm.environment.set('antenneId', String(abj.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{studentBaseUrl}}/antennes",
              "host": ["{{studentBaseUrl}}"],
              "path": ["antennes"]
            }
          },
          "response": []
