        {
          "name": "GET /:matricule - seeded student",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('returns seeded student with relations', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.matricule).to.eql(pm.environment.get('seedMatricule'));",
                  "  pm.expect(json.antenne).to.be.an('object');",
                  "  pm.expect(json.niveau).to.be.an('object');",
                  "  pm.expect(json.statut).to.be.an('object');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{studentBaseUrl}}/{{seedMatricule}}",
              "host": ["{{studentBaseUrl}}"],
              "path": ["{{seedMatricule}}"]
            }
          },
          "response": []
        },
        {
          "name": "POST /batch",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('returns at least one student', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.be.an('array');",
                  "  pm.expect(json.length).to.be.at.least(1);",
                  "  pm.expect(json.map((student) => student.matricule)).to.include(pm.environment.get('seedMatricule'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"matricules\": [\"{{seedMatricule}}\", \"UNKNOWN-STUDENT\"]\n}"
            },
            "url": {
              "raw": "{{studentBaseUrl}}/batch",
              "host": ["{{studentBaseUrl}}"],
              "path": ["batch"]
            }
          },
          "response": []
