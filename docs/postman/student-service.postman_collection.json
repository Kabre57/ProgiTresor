        {
          "name": "POST / - create temporary student",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now();",
                  "pm.environment.set('testMatricule', `PM-${suffix}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('created student uses current referential ids', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.matricule).to.eql(pm.environment.get('testMatricule'));",
                  "  pm.expect(json.antenneId).to.eql(Number(pm.environment.get('antenneId')));",
                  "  pm.expect(json.niveauId).to.eql(Number(pm.environment.get('niveauId')));",
                  "  pm.expect(json.statutId).to.eql(Number(pm.environment.get('statutId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"matricule\": \"{{testMatricule}}\",\n  \"nom\": \"POSTMAN\",\n  \"prenom\": \"Tester\",\n  \"prefixeMatricule\": \"PM\",\n  \"antenneId\": {{antenneId}},\n  \"niveauId\": {{niveauId}},\n  \"statutId\": {{statutId}}\n}"
            },
            "url": {
              "raw": "{{studentBaseUrl}}/",
              "host": ["{{studentBaseUrl}}"],
              "path": [""]
            }
          },
          "response": []
        },
