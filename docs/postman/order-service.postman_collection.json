{
  "info": {
    "_postman_id": "f5e3a910-5f2c-4d88-9a7e-7c3e1b8d5f43",
    "name": "ProgiTresor - order-service",
    "description": "Tests Postman pour le microservice order-service. Importer aussi l'environnement local fourni dans ce dossier.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('service is healthy', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.eql('ok');",
                  "  pm.expect(json.service).to.eql('order-service');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{orderBaseUrl}}/health",
              "host": ["{{orderBaseUrl}}"],
              "path": ["health"]
            }
          },
          "response": []
        },
        {
          "name": "GET /metrics",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('contains prometheus metrics', function () {",
                  "  pm.expect(pm.response.text()).to.include('order_http_request_duration_ms');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{orderBaseUrl}}/metrics",
              "host": ["{{orderBaseUrl}}"],
              "path": ["metrics"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "GET / - list orders (paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('returns paginated order list', function () {",
                  "  pm.expect(json.list).to.be.an('array');",
                  "  pm.expect(json).to.have.property('total');",
                  "  pm.expect(json).to.have.property('limit');",
                  "  pm.expect(json).to.have.property('offset');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{orderBaseUrl}}/?limit=20&page=1",
              "host": ["{{orderBaseUrl}}"],
              "path": [""],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "page", "value": "1" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "POST /generate - generate orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 or 201', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "const json = pm.response.json();",
                  "if (pm.response.code === 201) {",
                  "  pm.test('synthese and orders generated', function () {",
                  "    pm.expect(json.synthese).to.have.property('reference');",
                  "    pm.expect(json.orders).to.be.an('array');",
                  "    pm.environment.set('seedCodeOt', json.orders[0].codeOt);",
                  "    pm.environment.set('seedSyntheseRef', json.synthese.reference);",
                  "    pm.environment.set('seedSyntheseId', String(json.synthese.id));",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-user-role",
                "value": "COMPTABLE"
              },
              {
                "key": "x-user-id",
                "value": "1"
              }
            ],
            "url": {
              "raw": "{{orderBaseUrl}}/generate",
              "host": ["{{orderBaseUrl}}"],
              "path": ["generate"]
            }
          },
          "response": []
        },
        {
          "name": "PUT /:code/status - update order status to Transmis",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('order status updated', function () {",
                  "  pm.expect(json.codeOt).to.eql(pm.environment.get('seedCodeOt'));",
                  "  pm.expect(json.statut).to.eql('Transmis');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-user-role",
                "value": "COMPTABLE"
              },
              {
                "key": "x-user-id",
                "value": "1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"statut\": \"Transmis\"\n}"
            },
            "url": {
              "raw": "{{orderBaseUrl}}/{{seedCodeOt}}/status",
              "host": ["{{orderBaseUrl}}"],
              "path": ["{{seedCodeOt}}", "status"]
            }
          },
          "response": []
        }
      ]
    },
