            }
          },
          "response": []
        },
        {
          "name": "GET /syntheses/ref/:reference - get synthese by reference",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('returns correct synthese details', function () {",
                  "  pm.expect(json.reference).to.eql(pm.environment.get('seedSyntheseRef'));",
                  "  pm.expect(json.ordresTraitement).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{orderBaseUrl}}/syntheses/ref/{{seedSyntheseRef}}",
              "host": ["{{orderBaseUrl}}"],
              "path": ["syntheses", "ref", "{{seedSyntheseRef}}"]
            }
          },
          "response": []
        },
        {
          "name": "GET /syntheses/:id - get synthese by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('returns correct synthese by id', function () {",
                  "  pm.expect(json.id).to.eql(Number(pm.environment.get('seedSyntheseId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{orderBaseUrl}}/syntheses/{{seedSyntheseId}}",
              "host": ["{{orderBaseUrl}}"],
              "path": ["syntheses", "{{seedSyntheseId}}"]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('orderBaseUrl')) {",
          "  throw new Error('Missing Postman environment variable: orderBaseUrl');",
          "}"
        ]
      }
    }
  ]
}
