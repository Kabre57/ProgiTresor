        {
          "name": "POST /import - import transactions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('import completed successfully', function () {",
                  "  pm.expect(json.message).to.eql('Import process completed');",
                  "  pm.expect(json).to.have.property('imported');",
                  "  pm.expect(json).to.have.property('duplicatesSkipped');",
                  "  pm.expect(json).to.have.property('importId');",
                  "  pm.expect(json.imported).to.eql(2);",
                  "});",
                  "",
                  "pm.environment.set('testImportId', String(json.importId));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now();",
                  "pm.environment.set('testRefTresor1', `PM-TR-${suffix}-001`);",
                  "pm.environment.set('testRefTresor2', `PM-TR-${suffix}-002`);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomFichier\": \"POSTMAN_TEST_IMPORT.xlsx\",\n  \"typeFichier\": \"XLSX\",\n  \"auteurId\": 1,\n  \"periodeDebut\": \"2024-02-01\",\n  \"periodeFin\": \"2024-02-28\",\n  \"items\": [\n    {\n      \"refTresor\": \"{{testRefTresor1}}\",\n      \"montant\": 25000,\n      \"dateHeure\": \"2024-02-10T09:00:00Z\",\n      \"etudiantId\": 1,\n      \"antenneId\": 1,\n      \"nomenclatureId\": 1,\n      \"typeFluxId\": 1,\n      \"mois\": \"FEVRIER\",\n      \"nomPayeurBrut\": \"POSTMAN PAYEUR\",\n      \"libelleProduitBrut\": \"FRAIS DE SCOLARITE TEST\"\n    },\n    {\n      \"refTresor\": \"{{testRefTresor2}}\",\n      \"montant\": 10000,\n      \"dateHeure\": \"2024-02-15T14:30:00Z\",\n      \"etudiantId\": 2,\n      \"antenneId\": 2,\n      \"nomenclatureId\": 3,\n      \"typeFluxId\": 2,\n      \"mois\": \"FEVRIER\",\n      \"nomPayeurBrut\": \"POSTMAN PAYEUR 2\",\n      \"libelleProduitBrut\": \"FRAIS ENCADREMENT TEST\"\n    }\n  ]\n}"
            },
