    {
      "name": "Imports",
      "item": [
        {
          "name": "GET /imports - list seeded imports",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('returns paginated import list', function () {",
                  "  pm.expect(json.list).to.be.an('array');",
                  "  pm.expect(json.list.length).to.be.at.least(1);",
                  "  pm.expect(json).to.have.property('total');",
                  "  pm.expect(json).to.have.property('limit');",
                  "  pm.expect(json).to.have.property('offset');",
                  "});",
                  "",
                  "pm.test('import has expected fields', function () {",
                  "  const imp = json.list[0];",
                  "  pm.expect(imp).to.have.property('id');",
                  "  pm.expect(imp).to.have.property('nomFichier');",
                  "  pm.expect(imp).to.have.property('typeFichier');",
                  "  pm.expect(imp).to.have.property('statut');",
                  "  pm.expect(imp).to.have.property('transactions');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{txBaseUrl}}/imports",
              "host": ["{{txBaseUrl}}"],
              "path": ["imports"]
            }
          },
          "response": []
        },
