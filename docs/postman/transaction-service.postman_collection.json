          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ordreTraitementId\": 1\n}"
            },
            "url": {
              "raw": "{{txBaseUrl}}/link-ot",
              "host": ["{{txBaseUrl}}"],
              "path": ["link-ot"]
            }
          },
          "response": []
        },
