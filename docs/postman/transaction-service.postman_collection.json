    {
      "name": "Transactions",
      "item": [
        {
          "name": "GET / - list transactions (paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('returns paginated transaction list', function () {",
                  "  pm.expect(json.list).to.be.an('array');",
                  "  pm.expect(json.list.length).to.be.at.least(2);",
                  "  pm.expect(json).to.have.property('total');",
                  "  pm.expect(json).to.have.property('limit');",
                  "  pm.expect(json).to.have.property('offset');",
                  "});",
                  "",
                  "pm.test('transaction has expected fields', function () {",
                  "  const tx = json.list[0];",
                  "  pm.expect(tx).to.have.property('id');",
                  "  pm.expect(tx).to.have.property('refTresor');",
                  "  pm.expect(tx).to.have.property('montant');",
                  "  pm.expect(tx).to.have.property('dateHeure');",
                  "  pm.expect(tx).to.have.property('statutTraitement');",
                  "  pm.expect(tx).to.have.property('importFichier');",
                  "});",
                  "",
                  "// Store unassigned transaction ids for link-ot test",
                  "const unassigned = json.list.filter(tx => tx.ordreTraitementId === null);",
                  "if (unassigned.length > 0) {",
                  "  pm.environment.set('testTransactionIds', JSON.stringify(unassigned.slice(0, 2).map(tx => Number(tx.id))));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{txBaseUrl}}/?limit=50&offset=0",
              "host": ["{{txBaseUrl}}"],
              "path": [""],
              "query": [
                { "key": "limit", "value": "50" },
                { "key": "offset", "value": "0" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /unassigned - hors budget unassigned",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('returns array of unassigned transactions', function () {",
                  "  pm.expect(json).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('all returned transactions are unassigned and hors budget', function () {",
                  "  json.forEach(function (tx) {",
                  "    pm.expect(tx.ordreTraitementId).to.be.null;",
                  "    pm.expect(tx.typeFluxId).to.eql(2);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{txBaseUrl}}/unassigned",
              "host": ["{{txBaseUrl}}"],
              "path": ["unassigned"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "OT Linking",
      "item": [
        {
          "name": "POST /link-ot - link transactions to OT",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now();",
                  "pm.environment.set('testCodeOt', `OT-PM-${suffix}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// This may fail if no unassigned transactions exist; that is expected",
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.test('linked successfully', function () {",
                  "    pm.expect(json.message).to.eql('Linked successfully');",
                  "    pm.expect(json.updatedCount).to.be.at.least(1);",
                  "  });",
                  "} else {",
                  "  pm.test('response is 400 (already linked or no IDs)', function () {",
                  "    pm.response.to.have.status(400);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ordreTraitementId\": 100,\n  \"codeOt\": \"{{testCodeOt}}\",\n  \"transactionIds\": {{testTransactionIds}}\n}"
            },
            "url": {
              "raw": "{{txBaseUrl}}/link-ot",
              "host": ["{{txBaseUrl}}"],
              "path": ["link-ot"]
            }
          },
          "response": []
        },
