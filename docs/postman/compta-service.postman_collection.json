    {
      "name": "Comptes",
      "item": [
        {
          "name": "GET /comptes - list comptes (paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('returns paginated account list', function () {",
                  "  pm.expect(json.data).to.be.an('array');",
                  "  pm.expect(json.data.length).to.be.at.least(1);",
                  "  pm.expect(json).to.have.property('total');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-user-role", "value": "COMPTABLE" },
              { "key": "x-user-id", "value": "1" }
            ],
            "url": {
              "raw": "{{comptaBaseUrl}}/api/comptes?limit=20&page=1",
              "host": ["{{comptaBaseUrl}}"],
              "path": ["api", "comptes"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "page", "value": "1" }
              ]
            }
          },
          "response": []
        },
