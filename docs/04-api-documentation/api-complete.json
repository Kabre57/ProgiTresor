{
  "openapi": "3.0.0",
  "info": {
    "title": "ProgiTresor Unified API Documentation",
    "version": "1.0.0",
    "description": "Unified contract for all ProgiTresor microservices"
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "summary": "Authenticate user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful"
          },
          "401": {
            "description": "Invalid username or password"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Retrieve currently authenticated user profile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User profile retrieved"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/api/etudiant/batch": {
      "post": {
        "summary": "Batch lookup etudiant profiles",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "matricules"
                ],
                "properties": {
                  "matricules": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "List of resolved etudiant profiles"
          }
        }
      }
    },
    "/api/etudiant/{matricule}": {
      "get": {
        "summary": "Get etudiant by matricule",
        "parameters": [
          {
            "in": "path",
            "name": "matricule",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Etudiant profile retrieved"
          },
          "404": {
            "description": "Etudiant not found"
          }
        }
      },
      "put": {
        "summary": "Update a etudiant",
        "responses": {
          "200": {
            "description": "Etudiant updated"
          }
        }
      }
    },
    "/api/etudiant/": {
      "post": {
        "summary": "Create a etudiant",
        "responses": {
          "201": {
            "description": "Etudiant created"
          }
        }
      }
    },
    "/api/transaction/import": {
      "post": {
        "summary": "Import a list of transactions",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "reference_tresor",
                    "montant",
                    "date_heure",
                    "produit"
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Import finished successfully"
          }
        }
      }
    },
    "/api/transaction/": {
      "get": {
        "summary": "Retrieve transactions list",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of transactions"
          }
        }
      }
    },
    "/api/transaction/unassigned": {
      "get": {
        "summary": "Retrieve unassigned Hors Budget transactions",
        "responses": {
          "200": {
            "description": "Unassigned list"
          }
        }
      }
    },
    "/api/transaction/link-ot": {
      "post": {
        "summary": "Link transactions to an OT code",
        "responses": {
          "200": {
            "description": "Linked successfully"
          }
        }
      }
    },
    "/api/transaction/unlink-ot": {
      "post": {
        "summary": "Unlink transactions from an OT",
        "responses": {
          "200": {
            "description": "Unlinked successfully"
          }
        }
      }
    },
    "/api/order/generate": {
      "post": {
        "summary": "Generate payment orders through Saga orchestration",
        "responses": {
          "200": {
            "description": "OPs generated successfully"
          },
          "500": {
            "description": "Saga execution failed and changes rolled back"
          }
        }
      }
    },
    "/api/order/{code}/status": {
      "put": {
        "summary": "Update payment order status",
        "parameters": [
          {
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "statut_ot"
                ],
                "properties": {
                  "statut_ot": {
                    "type": "string",
                    "enum": [
                      "Brouillon",
                      "Transmis au Budget",
                      "Validé",
                      "Approuvé",
                      "Rejeté",
                      "Payé"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status updated"
          }
        }
      }
    },
    "/api/order/": {
      "get": {
        "summary": "Retrieve payment orders list",
        "responses": {
          "200": {
            "description": "List of OPs"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}